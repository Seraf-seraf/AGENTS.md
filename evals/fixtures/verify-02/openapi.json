{
  "openapi": "3.0.3",
  "info": {
    "title": "Artifact catalog API",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/artifacts": {
      "get": {
        "operationId": "listArtifacts",
        "responses": {
          "200": {
            "description": "Stored artifacts in their original order.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactList"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArtifactList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifacts"
            ],
            "properties": {
              "artifacts": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Artifact"
                }
              }
            }
          }
        }
      },
      "Artifact": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "metadata"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "metadata": {
            "$ref": "#/components/schemas/ArtifactMetadata"
          }
        }
      },
      "ArtifactMetadata": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "media_type": {
            "type": "string"
          },
          "byte_length": {
            "type": "integer",
            "minimum": 0
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "allOf": [
          {
            "$ref": "#/components/schemas/FileMetadata"
          },
          {
            "required": [
              "revision"
            ]
          }
        ]
      },
      "FileMetadata": {
        "type": "object",
        "required": [
          "media_type",
          "byte_length"
        ],
        "properties": {
          "media_type": {
            "type": "string"
          },
          "byte_length": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
